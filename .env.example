PORT=8787
ANDRO_API_KEY=replace-with-a-long-random-secret
ANDRO_WORKER_TOKEN=replace-with-a-different-long-random-secret
# PostgreSQL connection string for a dedicated Andro database/schema. Do not use a public browser key.
DATABASE_URL=postgresql://andro_user:replace-me@db-host:5432/postgres
# For local PostgreSQL, set DATABASE_SSL=disable. For managed DBs, keep SSL enabled.
DATABASE_SSL=enable
DATABASE_SSL_STRICT=true
DB_POOL_MAX=5
CORS_ORIGIN=
# Worker configuration (set these in the worker environment)
ANDRO_SERVER_URL=http://andro-api:8787
ANDRO_POLL_MS=2000
ANDRO_BUILD_TIMEOUT_MS=1200000

# Supabase Storage server-side credentials. Never put these in browser code or build containers.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-side-secret-key
ANDRO_ARTIFACT_BUCKET=andro-artifacts
ANDRO_MAX_ARTIFACT_BYTES=536870912
# Worker host must have Docker Engine available and this image pre-pulled/built.
ANDRO_RUNNER_IMAGE=andro-android-runner:latest
ANDRO_WORK_ROOT=/var/lib/andro-work
ANDRO_JOB_CPUS=2
ANDRO_JOB_MEMORY=6g
ANDRO_JOB_PIDS=512
